session {
  name = "open source"

  window {
    name = "No panel"
  }

  window {
    name = "Single empty panel"

    panel {}
  }

  window {
    name = "Single panel"

    panel {
      path = "/tmp"
      cmd = "ls -lah"
    }
  }

  window {
    name = "Vertical Empty Split"

    vpanel {}
  }

  window {
    name = "Vertical Empty Left and Right"

    vpanel {
      left {}
      right {}
    }
  }

  window {
    name = "Horizontal Empty Split"

    hpanel {}
  }

  window {
    name = "Horizontal Empty Top and Bottom"

    hpanel {
      top {}
      bottom {}
    }
  }
}

