# It's a fake example file. It'll not work on your machine. If you want to make exactly this work, you'll need to create those paths and have vi installed

session {
  name = "tmuxer project"

  window {
    name = "tmuxer development"

    vpanel {
      left {
        hpanel {
          top {
            panel {
              path = "~/tools/tmuxer/src"
              cmd = "vi ."
            }
          }
          bottom {
            panel {
              path = "~/tools/tmuxer"
              cmd = "nimble build"
            }
          }
        }
      }

      right {
        hpanel {
          top {
            panel {
              path = "~/tools/tmuxer/examples"
              cmd = "vi .tmuxer.txr"
            }
          }

          bottom {
            panel {
              path = "~/tools/tmuxer/"
              cmd = "ln -s ./examples/.tmuxer.txr . 2>/dev/null || : && ./bin/tmuxer -v"
            }
          }
        }
      }
    }
  }
}

# vim: set ft=conf :
